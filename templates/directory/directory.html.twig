{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - {{ view_name }}{% endblock %}

{% block body %}
{% embed '_page_header.html.twig' %}
{% block page_header_title %}{{ view_name }}{% endblock %}
{% block page_header_buttons %}
{% if messenger is defined and is_granted('ROLE_COMMUNICATIONS_MANAGER') %}
<button type="button" class="btn btn-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
  <i class="fas fa-comments fa-fw"></i> Messenger
</button>
<div class="dropdown-menu">
  <a class="dropdown-item" href="{{ path('messenger_email', {(messenger.key) : messenger.value}) }}"><i class="fas fa-envelope fa-fw"></i> Send Email</a>
  {% if is_sms_service_configured() %}
  <a class="dropdown-item" href="{{ path('messenger_sms', {(messenger.key) : messenger.value}) }}"><i class="fas fa-sms fa-fw"></i> Send SMS</a>
  {% endif %}
</div>
{% endif %}
{% if is_granted('ROLE_DIRECTORY_MANAGER') %}
<a role="button" href="{{ path('member_new') }}" class="btn btn-sm btn-primary"><i class="fas fa-plus fa-fw"></i> New Member</a>
{% endif %}
<a role="button" href="{{ path('export') }}" class="btn btn-sm btn-primary"><i class="fas fa-download fa-fw"></i> Export</a>
{% endblock %}
{% endembed %}

{% if view_description is defined %}
{{ view_description|e('html')|markdown_to_html }}
{% endif %}

{% set columns = [
    col(name: 'localIdentifier', title: 'Roll #', sortable: true, width: '5rem'),
    col(name: 'photoUrl', title: '', sortable: false),
    col(name: 'displayName', title: 'Name', sortable: false, searchable: true, width: '16rem'),
    col(name: 'status', title: 'Status', sortable: true, browsable: true, visible: show_status|default(true)),
    col(name: 'classYear', title: 'Class', sortable: true, browsable: true),
    col(name: 'primaryEmail', title: 'Email', searchable: true),
    col(name: 'facebookUrl', title: 'Social', sortable: false),
    col(name: 'primaryTelephoneNumber', title: 'Phone Number'),
    col(name: 'mailingPostalCode', title: 'Mailing Address', sortable: false),
    col(name: 'mailingState', title: 'State', visible: false, browsable: true),
] %}

<div class="card shadow">
  <div class="card-body">
    <twig:api_grid
        class="App\\Entity\\Member"
        :apiGetCollectionUrl="apiGetCollectionUrl"
        :filter="filter|default({})"
        :columns="columns"
        :caller="_self"
        pageLength="25"
    >
        <twig:block name="photoUrl">
            <a href="{{ path('member_show', {localIdentifier: row.localIdentifier}) }}">
                <img src="{{ row.photoUrl|default(null) ?: row.gravatarUrl }}" class="img-fluid" alt="Profile Photo" />
            </a>
        </twig:block>

        <twig:block name="displayName">
            <a href="{{ path('member_show', {localIdentifier: row.localIdentifier}) }}">{{ row.displayName }}</a>
            <div class="mt-1">
                {% if row.isDeceased %}
                    <a href="{{ path('deceased') }}"><sup class="badge bg-black text-white" title="Deceased">Deceased</sup></a>
                {% endif %}
                {% if row.isLost %}
                    <a href="{{ path('lost') }}"><sup class="badge bg-warning text-bg-warning" title="Lost">Lost</sup></a>
                {% endif %}
                {% if row.isLocalDoNotContact %}
                    <a href="{{ path('do_not_contact') }}"><sup class="badge bg-danger text-bg-danger" title="Do Not Contact">Do Not Contact</sup></a>
                {% endif %}
                {% for tag in row.tags|default([]) %}
                    <a href="{{ path('tag', {tagId: tag.id}) }}"><sup class="badge bg-secondary text-bg-secondary" title="{{ tag.tagName }}">{{ tag.tagName }}</sup></a>
                {% endfor %}
            </div>
        </twig:block>

        <twig:block name="status">
            {{ row.status.label|default('') }}
        </twig:block>

        <twig:block name="primaryEmail">
            {% if row.primaryEmail %}
                <a href="mailto:{{ row.primaryEmail }}">{{ row.primaryEmail }}</a>
            {% endif %}
        </twig:block>

        <twig:block name="facebookUrl">
            {% if row.linkedinUrl %}
                <a href="{{ row.linkedinUrl }}"><i class="fab fa-linkedin fa-lg fa-fw"></i></a>
            {% else %}
                <i class="fab fa-linkedin fa-lg fa-fw" style="opacity:0.2"></i>
            {% endif %}
            {% if row.facebookUrl %}
                <a href="{{ row.facebookUrl }}"><i class="fab fa-facebook fa-lg fa-fw"></i></a>
            {% else %}
                <i class="fab fa-facebook fa-lg fa-fw" style="opacity:0.2"></i>
            {% endif %}
        </twig:block>

        <twig:block name="mailingPostalCode">
            {% if row.mailingCity and row.mailingState %}
                {% if row.mailingAddressLine1 %}{{ row.mailingAddressLine1 }}<br />{% endif %}
                {% if row.mailingAddressLine2 %}{{ row.mailingAddressLine2 }}<br />{% endif %}
                {{ row.mailingCity }}, {{ row.mailingState }} {{ row.mailingPostalCode }}<br />
                {% if row.mailingCountry not in ['United States', 'US'] %}{{ row.mailingCountry }}{% endif %}
            {% endif %}
        </twig:block>
    </twig:api_grid>
  </div>
</div>

{% endblock %}
