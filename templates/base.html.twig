{% extends '@SurvosTabler/layout/base.html.twig' %}

{% block javascripts %}
    {{ importmap('app') }}
{% endblock %}

{# app pages render their own header via {% embed '_page_header.html.twig' %} inside body, #}
{# so tabler's built-in page_header block (title/pretitle/actions) stays unused here. #}
{% block page_header %}{% endblock %}

{% block footer %}
    <footer class="footer footer-transparent d-print-none">
        <div class="container-xl">
            <div class="row text-center">
                <div class="col-12">
                    <small class="text-muted">Powered by <a href="https://github.com/utmsigep/member-directory" target="_blank">Member Directory</a> ({{ config.version }})</small>
                </div>
            </div>
        </div>
    </footer>
{% endblock %}
